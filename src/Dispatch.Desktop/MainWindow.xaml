<Window x:Class="Dispatch.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Dispatch.Desktop"
        Title="Codex 调度工具" Icon="Assets/app.ico" Width="1120" Height="780" MinWidth="980" MinHeight="700" Background="#F5F6F8" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#202731" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="ModuleSwitch" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#D3D9E1" BorderBrush="#BAC2CE" BorderThickness="1"><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" Margin="3" HorizontalAlignment="Left"/></Border><ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#A31E2E"/><Setter TargetName="Track" Property="BorderBrush" Value="#A31E2E"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#202731"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <local:PageVisibility x:Key="Page"/>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9DEE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9DEE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#C52B3A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B92335"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#B92335"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9DEE5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="6" Background="White" BorderBrush="#D9DEE5" BorderThickness="1"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Margin="12,8,35,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border CornerRadius="6" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E6EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Subtle" TargetType="TextBlock"><Setter Property="Foreground" Value="#697586"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="40"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FAFBFC"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F4F6F8"/><Setter Property="Foreground" Value="#596779"/><Setter Property="Padding" Value="8,10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F5F6F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E3E6EB" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="18,27,14,28"><Border Background="#B92335" CornerRadius="8" Width="38" Height="38" HorizontalAlignment="Left"><TextBlock Text="调" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Codex 调度工具" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,5"/><TextBlock Text="多窗口 · 统一测试队列" Foreground="#7B8491" FontSize="11"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="18,16"><TextBlock Text="本地运行" Foreground="#596779"/><TextBlock Text="独立工具管理 · 0.11.3" Foreground="#8A929E" FontSize="11" Margin="0,6,0,0"/></StackPanel>
    <ListBox SelectedIndex="{Binding PageIndex}" BorderThickness="0" Background="Transparent" Padding="10,0" AutomationProperties.AutomationId="Navigation">
     <ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Nav" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#F9EDEF"/><Setter Property="Foreground" Value="#A31E2E"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#F3F4F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources>
     <ListBoxItem Content="◫    调度总览"/><ListBoxItem Content="☷    测试队列"/><ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ConnectionGlyph}" Foreground="{Binding ConnectionColor}" Width="25" FontWeight="Bold"/><TextBlock Text="Codex 连接"/></StackPanel></ListBoxItem><ListBoxItem Content="⚙    诊断与日志"/><ListBoxItem Content="高级产物留档" Visibility="Collapsed"/><ListBoxItem Content="◉    工具管理"/>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,22,26,20">
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0"><Border DockPanel.Dock="Right" CornerRadius="6" Background="White" BorderBrush="{Binding ConnectionColor}" BorderThickness="1" Padding="10,8" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="{Binding ConnectionHint}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ConnectionGlyph}" Foreground="{Binding ConnectionColor}" FontWeight="Bold" Margin="0,0,7,0"/><TextBlock Text="{Binding ConnectionBadge}" Foreground="{Binding ConnectionColor}"/></StackPanel></Border><Border DockPanel.Dock="Right" Background="White" CornerRadius="6" Padding="12,8" VerticalAlignment="Top" BorderBrush="#E3E6EB" BorderThickness="1"><TextBlock Text="{Binding ServiceSummary}"/></Border><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="开发窗口继续工作，共享测试有序执行。" Style="{StaticResource Subtle}" Margin="0,5,0,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="#FFF5E8" BorderBrush="#F1DEC0" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,16"><TextBlock Text="{Binding ModuleSummary}" Foreground="#805B2A" TextWrapping="Wrap"/></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageIndex, Converter={StaticResource Page}, ConverterParameter=5}"><StackPanel IsEnabled="{Binding CanOperate}">
    <TextBlock Text="两个工具各自启停，可同时使用，也可只使用其中一个。" TextWrapping="Wrap" Margin="0,0,0,14" Style="{StaticResource Subtle}"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
     <TextBlock Text="测试排队" Style="{StaticResource Heading}"/>
     <TextBlock Text="安排多个窗口使用 SolidWorks 或桌面的先后顺序，管理测试与资源许可。" Style="{StaticResource Subtle}" Margin="0,0,0,14"/>
     <CheckBox Style="{StaticResource ModuleSwitch}" Content="启用测试排队" IsChecked="{Binding QueueEnabled, Mode=OneWay}" Command="{Binding ToggleQueueCommand}" AutomationProperties.AutomationId="QueueModuleSwitch"/>
     <TextBlock Text="{Binding QueueModuleState}" TextWrapping="Wrap" Margin="0,12,0,6"/>
     <TextBlock Text="{Binding QueueConnectionState}" Style="{StaticResource Subtle}" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="接入排队工具" Command="{Binding ConnectQueueCommand}"/><Button Content="解除排队接入" Command="{Binding DisconnectQueueCommand}"/></WrapPanel>
     <Expander x:Name="QueueResumePanel" Header="排队任务自动接续（按聊天授权）" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="原聊天正常结束回复后，允许调度工具为同一排队任务发送接续提醒并启动下一轮。不会新建聊天或改变模型。" Style="{StaticResource Subtle}" Margin="0,8,0,10"/>
      <TextBlock Text="真实聊天编号（由原窗口提供，不填写会话别名）" Style="{StaticResource Subtle}"/>
      <Border BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="6" Background="White" Padding="2" Margin="0,6,0,10"><TextBox Text="{Binding QueueResumeThread, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="QueueResumeThread"/></Border>
      <CheckBox Content="允许此聊天的原排队任务自动接续" IsChecked="{Binding QueueResumeEnabled}" Margin="0,0,0,10" AutomationProperties.AutomationId="QueueResumeConsent"/>
      <WrapPanel><Button Content="保存排队接续授权" Command="{Binding SaveQueueResumeCommand}"/><Button Content="填入当前主管聊天" Command="{Binding FillQueueThreadCommand}"/></WrapPanel>
      <TextBlock Text="{Binding QueueResumeSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
     <TextBlock Text="模型调度" Style="{StaticResource Heading}"/>
     <TextBlock Text="由你指定主管，主管决定执行模型。执行完成或中途需要接管时，带着进度返回主管。" Style="{StaticResource Subtle}" Margin="0,0,0,14"/>
     <CheckBox Style="{StaticResource ModuleSwitch}" Content="启用模型调度" IsChecked="{Binding ModelsEnabled, Mode=OneWay}" Command="{Binding ToggleModelsCommand}" AutomationProperties.AutomationId="ModelsModuleSwitch"/>
     <TextBlock Text="{Binding ModelsModuleState}" TextWrapping="Wrap" Margin="0,12,0,6"/>
     <TextBlock Text="{Binding ModelsConnectionState}" Style="{StaticResource Subtle}" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="接入模型工具" Command="{Binding ConnectModelsCommand}"/><Button Content="解除模型接入" Command="{Binding DisconnectModelsCommand}"/></WrapPanel>
    </StackPanel></Border>
    <WrapPanel Margin="0,0,0,12"><Button Content="同时接入两个工具" Command="{Binding ConnectBothCommand}" Style="{StaticResource Primary}"/><Button Content="重新检测接入" Command="{Binding InspectCommand}"/></WrapPanel>
    <TextBlock Text="开关即时保存，无需重载 Codex。首次登记或解除工具后，需重载 Codex 更新工具清单。关闭工具仍会保留已有任务的清理及返回通道。主管和排除模型设置位于“诊断与日志”。" Style="{StaticResource Subtle}"/>
   </StackPanel></ScrollViewer>
   <!-- 候选版本：只复制与校验，不部署或执行 -->
   <Grid Grid.Row="2" Visibility="{Binding PageIndex, Converter={StaticResource Page}, ConverterParameter=4}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel IsEnabled="{Binding CanOperate}">
     <DockPanel><Button DockPanel.Dock="Right" Content="返回诊断" Command="{Binding CloseArchiveCommand}"/><TextBlock Text="产物留档（高级，可选）" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="日常测试排队无需填写此页。这里仅用于诊断时保存和校验副本。" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="候选名称" Margin="0,0,0,5"/><TextBlock Grid.Column="1" Text="产物目录" Margin="10,0,0,5"/>
      <TextBox Grid.Row="1" Text="{Binding CandidateName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
      <DockPanel Grid.Row="1" Grid.Column="1"><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseCandidateCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding CandidateSource, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
     </Grid>
     <TextBlock Text="相对文件路径（每行一个，包含所需依赖；最多128个文件、共256MB）" Style="{StaticResource Subtle}" Margin="0,10,0,5"/>
     <TextBox Text="{Binding CandidatePaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="CandidatePaths"/>
     <WrapPanel Margin="0,10,0,0"><Button Content="生成冻结副本" Command="{Binding FreezeCommand}" Style="{StaticResource Primary}"/><Button Content="校验所选版本" Command="{Binding VerifyCandidateCommand}"/><Button Content="打开副本目录" Command="{Binding OpenCandidateCommand}"/></WrapPanel>
    </StackPanel></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12"><DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"><DataGrid.Columns><DataGridTextColumn Header="候选名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="70"/><DataGridTextColumn Header="创建时间" Binding="{Binding Time}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="140"/></DataGrid.Columns></DataGrid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding CandidateResult}" TextWrapping="Wrap"/></ScrollViewer></Border>
   </Grid>
   <!-- 总览 -->
   <Grid Grid.Row="2" Visibility="{Binding PageIndex, Converter={StaticResource Page}, ConverterParameter=0}">
    <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
    <UniformGrid Columns="4" Margin="0,0,-10,15">
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="正在执行" Style="{StaticResource Subtle}"/><TextBlock Text="{Binding RunningCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="等待资源" Style="{StaticResource Subtle}"/><TextBlock Text="{Binding WaitingCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="模拟通过" Style="{StaticResource Subtle}"/><TextBlock Text="{Binding CompletedCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="需要关注" Style="{StaticResource Subtle}"/><TextBlock Text="{Binding AttentionCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
    </UniformGrid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,15"><DockPanel><TextBlock DockPanel.Dock="Top" Text="最近测试" Style="{StaticResource Heading}"/><DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutomationProperties.AutomationId="OverviewJobs"><DataGrid.Columns><DataGridTextColumn Header="测试" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Session}" Width="130"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90"/></DataGrid.Columns></DataGrid></DockPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="主管与执行模型交接" Style="{StaticResource Heading}"/><TextBlock Text="主管选择执行模型，工具保存周期；执行完成后按固定计划返回主管。" Style="{StaticResource Subtle}" Margin="0,0,0,12"/></StackPanel><DataGrid ItemsSource="{Binding Decisions}"><DataGrid.Columns><DataGridTextColumn Header="目标模型" Binding="{Binding Model}" Width="*"/><DataGridTextColumn Header="判断理由" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="执行状态" Binding="{Binding State}" Width="170"/></DataGrid.Columns></DataGrid></DockPanel></Border>
   </Grid>
   <!-- 测试队列 -->
   <Grid Grid.Row="2" Visibility="{Binding PageIndex, Converter={StaticResource Page}, ConverterParameter=1}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="175"/></Grid.RowDefinitions>
    <WrapPanel IsEnabled="{Binding CanOperate}" Margin="0,0,0,14"><ComboBox Width="280" ItemsSource="{Binding Suites}" SelectedItem="{Binding SelectedSuite}" Margin="0,0,10,8" AutomationProperties.AutomationId="SuiteSelector"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="提交所选检查" Command="{Binding SubmitCommand}" Style="{StaticResource Primary}" Margin="0,0,8,8" AutomationProperties.AutomationId="SubmitMock"/><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Margin="0,0,8,8"/><Button Content="取消所选" Command="{Binding CancelCommand}" Margin="0,0,8,8"/></WrapPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14"><DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutomationProperties.AutomationId="QueueJobs"><DataGrid.Columns><DataGridTextColumn Header="提交时间" Binding="{Binding Time}" Width="85"/><DataGridTextColumn Header="测试／使用目的" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="来源窗口" Binding="{Binding Session}" Width="110"/><DataGridTextColumn Header="资源" Binding="{Binding Resources}" Width="115"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/></DataGrid.Columns></DataGrid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="查看报告" Command="{Binding ReportCommand}" IsEnabled="{Binding CanOperate}" VerticalAlignment="Top"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Report}" TextWrapping="Wrap"/></ScrollViewer></DockPanel></Border>
   </Grid>
   <!-- 连接 -->
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageIndex, Converter={StaticResource Page}, ConverterParameter=2}"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="连接到现有 Codex" Style="{StaticResource Heading}"/><TextBlock Text="首次登记连接后，需要重载原来的 Codex 窗口，才能验证新工具是否已加载。" Style="{StaticResource Subtle}" Margin="0,0,0,18"/><WrapPanel IsEnabled="{Binding CanOperate}"><Button Content="{Binding ConnectButtonLabel}" Command="{Binding ConnectCommand}" AutomationProperties.AutomationId="ConnectCodex"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Primary}"><Style.Triggers><DataTrigger Binding="{Binding IsConnectionReady}" Value="True"><Setter Property="Background" Value="#18734B"/><Setter Property="BorderBrush" Value="#18734B"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="重新检测" Command="{Binding InspectCommand}"/><Button Content="解除连接" Command="{Binding DisconnectCommand}"/></WrapPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="工具注册"/><TextBlock Grid.Column="1" Text="{Binding ConnectionSummary}"/><TextBlock Grid.Row="1" Text="开发规则"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RulesSummary}"/><TextBlock Grid.Row="2" Text="本地桥连接"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BridgeSummary}"/><TextBlock Grid.Row="3" Text="调度服务"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServiceSummary}"/></Grid></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="接入范围" Style="{StaticResource Heading}"/><TextBlock Text="测试排队通过工具请求执行。主管由用户配置，任务委派由主管判断。已有窗口是否识别工具，需要重载后实际验证。" Style="{StaticResource Subtle}"/><Expander Header="配置与恢复" Margin="0,15,0,0"><StackPanel><TextBlock Text="{Binding HomePath}" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="恢复中断的连接操作" Command="{Binding RecoverCommand}" HorizontalAlignment="Left" IsEnabled="{Binding CanOperate}"/></StackPanel></Expander></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <!-- 诊断：整体可滚动，展开配置不会挤掉日志或按钮 -->
   <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding PageIndex, Converter={StaticResource Page}, ConverterParameter=3}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Expander x:Name="ModelAccessPanel" Header="模型切换接入检测" IsExpanded="True" Margin="0,0,0,12"><StackPanel>
      <Button Content="检测模型接入" Command="{Binding ModelAccessCommand}" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Left" Margin="0,8"/>
      <TextBlock Text="{Binding ModelAccessSummary}" TextWrapping="Wrap" Margin="0,5"/>
      <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding ModelCatalogText}" TextWrapping="Wrap" FontSize="12"/></ScrollViewer>
     </StackPanel></Expander>
     <Expander x:Name="SupervisorPanel" Header="主管模型与执行返回" Margin="0,0,0,12"><StackPanel IsEnabled="{Binding CanOperate}">
      <TextBlock Text="先检测模型。主管由用户指定；执行模型由主管决定，任务结束返回主管。" TextWrapping="Wrap" Margin="0,6"/>
      <TextBlock Text="已授权聊天" Style="{StaticResource Subtle}"/>
      <ComboBox ItemsSource="{Binding SupervisorThreads}" SelectedItem="{Binding SelectedSupervisorThread}" ToolTip="已明确授权自动交接的聊天" Margin="0,4,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="主管模型" Style="{StaticResource Subtle}"/><TextBlock Grid.Column="1" Text="主管推理强度" Style="{StaticResource Subtle}"/>
       <ComboBox Grid.Row="1" ItemsSource="{Binding SupervisorModels}" SelectedItem="{Binding SelectedSupervisorModel}" DisplayMemberPath="Name" Margin="0,4,12,4"/>
       <ComboBox x:Name="SupervisorEffortSelector" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SupervisorEfforts}" SelectedItem="{Binding SelectedSupervisorEffort}" Margin="0,4"/>
      </Grid>
      <TextBlock Text="{Binding SupervisorSummary}" TextWrapping="Wrap" Margin="0,6"/>
      <Button Content="保存主管配置" Command="{Binding SaveSupervisorCommand}" HorizontalAlignment="Left" Margin="0,6"/>
      <TextBlock Text="保存不会立即切换模型。用户临时改变模型或强度时，停止旧周期并重新核对。" Style="{StaticResource Subtle}" Margin="0,6"/>
      <Expander x:Name="ExclusionsPanel" Header="不参与调配的执行模型" Margin="0,10,0,4"><StackPanel>
       <TextBlock Text="勾选后排除该模型的所有推理强度。此设置按当前聊天保存；主管返回不受影响。" Style="{StaticResource Subtle}" Margin="0,6"/>
       <Border BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="6" Padding="10"><ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ExclusionChoices}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsExcluded}" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
       <TextBlock Text="{Binding ExclusionSummary}" TextWrapping="Wrap" Margin="0,8"/>
       <Button Content="保存排除名单" Command="{Binding SaveExclusionsCommand}" HorizontalAlignment="Left"/>
      </StackPanel></Expander>
     </StackPanel></Expander>
     <Expander Header="高级诊断工具" Margin="0,0,0,12"><Button Content="查看产物留档（可选）" Command="{Binding ShowArchiveCommand}" HorizontalAlignment="Left" Margin="0,8"/></Expander>
     <TextBlock Text="最近运行日志" Style="{StaticResource Heading}"/><TextBlock Text="{Binding DataPath}" Style="{StaticResource Subtle}" Margin="0,0,0,12"/>
     <WrapPanel IsEnabled="{Binding CanOperate}" Margin="0,0,0,14"><Button Content="刷新日志" Command="{Binding LogCommand}"/><Button Content="打开数据目录" Command="{Binding OpenFolderCommand}"/><Button Content="启动／检查服务" Command="{Binding StartCommand}"/><Button Content="安全停止服务" Command="{Binding StopCommand}"/></WrapPanel>
     <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="190" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FAFBFC" FontSize="12"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Border Grid.Row="3" Background="#EDF0F4" CornerRadius="6" Padding="12,10" Margin="0,16,0,0"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#536174" AutomationProperties.AutomationId="OperationNotice"/></Border>
  </Grid>
 </Grid>
</Window>
